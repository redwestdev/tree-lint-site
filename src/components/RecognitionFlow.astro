---
import { renderIcon, splitIndentCells } from '../plugins/file-tree-icons.mjs';

const nodes = [
  { prefix: '', name: 'src/' },
  {
    prefix: '├── ',
    name: 'components/',
    role: 'слой',
    key: 'components',
  },
  {
    prefix: '│   ├── ',
    name: 'buttons/',
    role: 'группа',
    key: 'buttons',
  },
  {
    prefix: '│   │   └── ',
    name: 'PrimaryButton.tsx',
    role: 'сущность',
    key: 'primary-button',
  },
  {
    prefix: '│   └── ',
    name: 'fields/',
    role: 'группа',
    key: 'fields',
  },
  {
    prefix: '│       └── ',
    name: 'TextField.tsx',
    role: 'сущность',
    key: 'text-field',
  },
  {
    prefix: '└── ',
    name: 'hooks/',
    role: 'слой',
    key: 'hooks',
  },
  {
    prefix: '    └── ',
    name: 'useCounter.ts',
    role: 'сущность',
    key: 'use-counter',
  },
];

const stages = [
  {
    title: 'Находим слои',
    description:
      'Ищем папки с именами из секции layers на всём пути внутри roots.',
    visibleRoles: ['components', 'hooks'],
  },
  {
    title: 'Ищем сущности в слоях',
    description:
      'Для каждого слоя проверяем только объявленные в нём типы сущностей.',
    visibleRoles: [
      'components',
      'hooks',
      'primary-button',
      'text-field',
      'use-counter',
    ],
  },
  {
    title: 'Определяем группы',
    description:
      'Подходящие обычные папки становятся группами, если содержат распознанную сущность или другую группу.',
    visibleRoles: [
      'components',
      'hooks',
      'primary-button',
      'text-field',
      'use-counter',
      'buttons',
      'fields',
    ],
  },
  {
    title: 'Применяем правила',
    description:
      'При финальном обходе rules проверяют распознанные слои, группы и сущности; затем формируется отчёт.',
    visibleRoles: [
      'components',
      'hooks',
      'primary-button',
      'text-field',
      'use-counter',
      'buttons',
      'fields',
    ],
    validate: true,
  },
];
---

<div class='not-content tl-flow'>
  <ol class='tl-flow__stages' aria-label='Этапы обработки дерева Tree-lint'>
    {
      stages.map((stage, index) => (
        <li class='tl-flow__stage'>
          <section aria-labelledby={`tl-flow-title-${index}`}>
            <div class='tl-flow__heading'>
              <span class='tl-flow__number' aria-hidden='true'>
                {index + 1}
              </span>
              <div>
                <h3 id={`tl-flow-title-${index}`} class='tl-flow__title'>
                  {stage.title}
                </h3>
                <p class='tl-flow__description'>{stage.description}</p>
              </div>
            </div>

            <figure class='tl-flow__figure'>
              <div
                class='tl-ft tl-flow__tree'
                role='list'
                aria-label='Структура проекта с уже распознанными ролями'
              >
                {nodes.map((node, nodeIndex) => {
                  const isDirectory = node.name.endsWith('/');
                  const isRecognized =
                    node.role && stage.visibleRoles.includes(node.key);
                  const icon = renderIcon(
                    node.name.replace(/\/$/, ''),
                    isDirectory,
                    `tl-flow-${index}-${nodeIndex}-`
                  );
                  const rowStyle = icon.color
                    ? `--tl-ft-c:${icon.color}`
                    : undefined;

                  return (
                    <div
                      class='tl-ft-line tl-flow__tree-line'
                      style={rowStyle}
                      role='listitem'
                    >
                      {splitIndentCells(node.prefix).map((cell) => (
                        <span class='tl-ft-guides' aria-hidden='true'>
                          {cell}
                        </span>
                      ))}
                      <Fragment set:html={icon.svg} />
                      <span class='tl-ft-name'>{node.name}</span>
                      {isRecognized && (
                        <span class='tl-ft-annotation'>← {node.role}</span>
                      )}
                    </div>
                  );
                })}
              </div>
              <figcaption>
                Одно и то же дерево; показаны роли, известные на этом этапе.
              </figcaption>
            </figure>

            {stage.validate && (
              <ul
                class='tl-flow__outcomes'
                aria-label='Возможные результаты проверки правил'
              >
                <li class='tl-flow__outcome tl-flow__outcome--error'>
                  <span aria-hidden='true'>✖</span> Ошибка — блокирует успешный
                  результат
                </li>
                <li class='tl-flow__outcome tl-flow__outcome--warning'>
                  <span aria-hidden='true'>⚠</span> Предупреждение — не
                  блокирует результат
                </li>
                <li class='tl-flow__outcome tl-flow__outcome--silent'>
                  <span aria-hidden='true'>—</span> Нарушений нет
                </li>
              </ul>
            )}
          </section>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .tl-flow {
    --tl-flow-line: var(--sl-color-gray-4);
    --tl-flow-border: var(--sl-color-hairline-light);
    --tl-flow-surface: var(--ec-frm-edBg, var(--sl-color-bg-inline-code));

    margin-block: 1.5rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .tl-flow__stages {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl-flow__stage {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--tl-flow-border);
    border-radius: 0.75rem;
    background-color: var(--tl-flow-surface);
  }

  .tl-flow__heading {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .tl-flow__number {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 50%;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
  }

  .tl-flow__title {
    margin: 0;
    color: var(--sl-color-text);
    font-size: var(--sl-text-lg);
    font-weight: 650;
  }

  .tl-flow__description {
    margin: 0.125rem 0 0;
  }

  .tl-flow__figure {
    margin: 0;
  }

  .tl-flow__tree {
    margin-block: 0.5rem 0;
    background-color: color-mix(in oklab, var(--sl-color-text) 5%, transparent);
  }

  .tl-flow__tree-line {
    font-size: var(--sl-text-xs, 0.8125rem);
  }

  .tl-flow__figure figcaption {
    margin-top: 0.375rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .tl-flow__outcomes {
    display: grid;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tl-flow__outcome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--sl-color-text) 5%, transparent);
  }

  .tl-flow__outcome span {
    width: 1.25rem;
    text-align: center;
    font-weight: 700;
  }

  .tl-flow__outcome--error span {
    color: var(--sl-color-red-high);
  }

  .tl-flow__outcome--warning span {
    color: var(--sl-color-orange-high);
  }

  .tl-flow__outcome--silent span {
    color: var(--sl-color-gray-3);
  }

  @media (min-width: 42rem) {
    .tl-flow__stage {
      padding: 1.125rem 1.25rem;
    }

    .tl-flow__tree {
      font-size: var(--sl-text-sm);
    }
  }
</style>
